<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.SDL3" Version="1.0.18" />
    <PackageReference Include="SDL3-CS" Version="3.4.12.3" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.12.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../Resources/lucide.ttf" Link="Resources/lucide.ttf">
      <LogicalName>lucide.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
